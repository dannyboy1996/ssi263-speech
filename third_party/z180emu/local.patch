index 1553150..508d52f 100644
--- a/z180/z180.c
+++ b/z180/z180.c
@@ -2215,6 +2215,12 @@ void z180_set_asci_irq(device_t *device, int channel, int state) {
 		cpustate->int_pending[Z180_INT_ASCI1] = state;
 }
 
+/* The ASCI0/ASCI1 interrupt-pending flags ([0], [1]): writing one is exactly z180_set_asci_irq, without
+   the call (bns.c re-asserts the level after every instruction). */
+UINT8 *z180_asci_irq_pending(device_t *device) {
+	return &get_safe_token(device)->int_pending[Z180_INT_ASCI0];
+}
+
 void z180_set_dreq0(device_t *device, int state) {
 	struct z180_state *cpustate = get_safe_token(device);
 	if (state)
@@ -3208,6 +3214,22 @@ void cpu_string_export_z180(device_t *device, int device_state_entry, char *stri
 	}
 }
 
+/* test harness hook: act as if a CALL addr ran at the current PC (leaving HALT first),
+   with BC and HL preloaded; the routine returns to where the CPU was */
+void cpu_inject_call_z180(device_t *device, UINT16 addr, UINT16 bc, UINT16 hl) {
+	struct z180_state *cpustate = get_safe_token(device);
+	LEAVE_HALT(cpustate);
+	PUSH(cpustate, PC);
+	cpustate->_PC = addr;
+	cpustate->_BC = bc;
+	cpustate->HL.w.l = hl;
+}
+
+/* cycles still to run in the current cpu_execute_z180 slice (for exact cycle stamps) */
+int cpu_icount_z180(device_t *device) {
+	return get_safe_token(device)->icount;
+}
