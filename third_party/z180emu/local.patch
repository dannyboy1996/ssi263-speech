diff --git a/z180/z180ops.h b/z180/z180ops.h
index 009eb17..ea07a3b 100644
--- a/z180/z180ops.h
+++ b/z180/z180ops.h
@@ -949,7 +949,11 @@ INLINE UINT8 SET(UINT8 bit, UINT8 value)
 /***************************************************************
  * OTDMR
  ***************************************************************/
+/* PC-- like ENTER_HALT: LEAVE_HALT does PC++ when an interrupt wakes the CPU,
+   and without this the instruction after SLP was skipped (BL2ENG's RAM hook
+   D655 = SLP; RET then fell into the speech buffer at D658). */
 #define SLP {                                                   \
 	cpustate->icount = 0;                                           \
+	cpustate->_PC--;                                                \
 	cpustate->HALT = 2;                                                 \
 }
